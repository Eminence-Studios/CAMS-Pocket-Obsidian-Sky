  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textBox: {fileID: 104917128}
  dialogueScreen: {fileID: 1756146243}
  lines:
  - "Hello freshman! I\u2019ll be your guide through your time here."
  - What's your name?
  - userInput
  - "It\u2019s a pleasure to meet you, charName."
  - "At the academy, we have a unique way of teaching magic. You\u2019ll do a task
    for the teacher, and if they find it satisfactory, they\u2019ll demonstrate the
    spell in a mock duel."
  - "Should you succeed in beating the teacher, you\u2019ll learn their spell. If
    you don\u2019t, you can always try again."
  - "Our school system is divided into four years, and each year you can take different
    lessons. You\u2019re only required to master one per year, so explore each one
    at your leisure."
  - 'Get to know the campus and your peers, and most importantly: Have fun!'
  hasCharName: 1
  isTutorial: 1
  inputPopup: {fileID: 326588544}
  userInputField: {fileID: 1281928558}
  changeScene: 1
  sceneID: 2

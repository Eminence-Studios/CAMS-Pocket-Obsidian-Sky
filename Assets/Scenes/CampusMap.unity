  m_Script: {fileID: 11500000, guid: 6cfd2cb9d605ef94caa109b419fc961f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textBox: {fileID: 104917128}
  dialogueScreen: {fileID: 1756146243}
  lines:
  - "Hello freshman! I\u2019ll be your guide through your time here."
  - What's your name?
  - userInput
  - "It\u2019s a pleasure to meet you, charName."
  - At the academy, we have a unique way of teaching magic.
  - "Throughout your four years here, you can take different lessons on the various
    elements. You\u2019re only required to master one per year, so explore each one
    at your leisure."
  - Mastery is awarded after learning spells from every teacher that instructs the
    element.
  - "To learn spells, you\u2019ll do a task for the teacher, and if they find it
    satisfactory, they\u2019ll demonstrate their spells in a mock duel."
  - "Should you succeed in beating the teacher, you\u2019ll be able to choose one
    of their spells to master. But don\u2019t worry. If the teacher deems you aren\u2019t
    ready yet, you can always try again another time."
  - "Here\u2019s a few basic spells to help you get started. They should be enough
    to get you through your first battles."
  - "That\u2019s it from me. Get to know the campus and most importantly: Have fun!"
  hasCharName: 1
  isTutorial: 1
  inputPopup: {fileID: 326588544}
  userInputField: {fileID: 1281928558}
  changeScene: 0
  sceneID: 0
  isTeacherDialogue: 0

  m_Script: {fileID: 11500000, guid: ae309fc9b93c4434b888290b1d747f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TeacherInteraction
  playerMovement: {fileID: 922991732}
  teacherName: King
  dialoguePopUp: {fileID: 518127579}
  dialogueManager: {fileID: 51559320}
  initalLines:
  - Hey!
  - Here for plant magic?
  - Well, first you have to understand how to ensure they grow.
  - Try tending to the plants around the room.
  afterPuzzleLines:
  - Great job!
  - The plants look nice and healthy now.
  - "Let\u2019s channel that energy into your magic."
  afterBattleLines:
  - "You\u2019ve mastered the basics!"
  - Keep growing with this new incantation.
  afterSpellLines:
  - Take care of yourself, just as you did with these plants.

  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TeacherInteraction
  playerMovement: {fileID: 1134639859}
  teacherName: Marquez
  dialoguePopUp: {fileID: 510418885}
  dialogueManager: {fileID: 949658290}
  spellSelectionScreen: {fileID: 0}
  element: 
  totalNumOfElementSpells: 0
  initalLines:
  - Hi there!
  - "Let\u2019s work together to help you harness the power of light magic."
  - Do you see those solar panels around the room?
  - Concentrate on emitting delicate energy towards each of them.
  - The light on each panel will glow green once enough energy has been stored.
  afterPuzzleLines:
  - Perfect!
  - Now, watch how we use light magic in battle.
  afterBattleLines:
  - You have a lot of potential for light magic.
  - The future is looking bright. Try this to harness more potent light energy next
    time.
  afterSpellLines:
  - Get those gears turning!

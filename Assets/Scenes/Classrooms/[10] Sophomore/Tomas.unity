  m_EditorClassIdentifier: Assembly-CSharp::TeacherInteraction
  playerMovement: {fileID: 139717606}
  teacherName: Tomas
  dialoguePopUp: {fileID: 208243415}
  dialogueManager: {fileID: 1165950374}
  spellSelectionScreen: {fileID: 1313934180}
  element: electric
  totalNumOfElementSpells: 3
  battleCanvas: {fileID: 1434711770}
  eventSystem: {fileID: 0}
  initalLines:
  - "What\u2019s up? How\u2019s campus?"
  - "There\u2019s a shocking variety of magic to learn, right?"
  - "Don\u2019t get discouraged if it gets difficult!"
  - The pressure at such a prestigious school might suck, but if ya use it as motivation,
    you can blast them right outta the park!
  - "Gotta roll with the punches, y\u2019know?"
  - "While we\u2019re rolling, how about you practice your electric control by rolling
    my golf cart through my baseball maze!"
  afterPuzzleLines:
  - "Hey, you\u2019re pretty good at that!"
  - "Let\u2019s see if you can roll with my punches."
  afterBattleLines:
  - "Here\u2019s a little something that might make your time here easier."
  afterSpellLines:
  - Keep up that spirit and keep on learning!
